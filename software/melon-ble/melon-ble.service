[Unit]
Description=Melon Pedal: Bluetooth LE bridge for the phone app
After=bluetooth.service melon-pedald.service
Wants=bluetooth.service
PartOf=melon-pedal.target
StartLimitIntervalSec=0

[Service]
User=__USER__
SupplementaryGroups=bluetooth
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __BLE_DIR__/melon_ble.py
# keep Bluetooth work off the audio cores (2-3)
CPUAffinity=0 1
Nice=5
Restart=always
RestartSec=3

[Install]
WantedBy=melon-pedal.target
